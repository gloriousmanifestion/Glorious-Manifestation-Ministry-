# Contact form: proxied to backend on same VM (like frontend).
# serve.mjs proxies /api/v1/* to BACKEND_URL. Form uses relative /api/v1/contact.
#
# Production (VM): BACKEND_URL set by CI/CD (http://127.0.0.1:6830 staging, 6840 production)
# Local dev: Vite proxy in vite.config.ts forwards /api/v1 to backend (default http://127.0.0.1:6830)
#
# For static hosting without proxy, set PUBLIC_API_URL at build time.
#
# Environment-aware links (Sign in, Partner with us). Set at build time by CI/CD:
# Staging: PUBLIC_PLUS_URL=https://beta-plus.1nga.online PUBLIC_BUSINESS_URL=https://beta-bus.1nga.online
# Production: PUBLIC_PLUS_URL=https://plus.1nga.com PUBLIC_BUSINESS_URL=https://business.1nga.com
# Local dev: defaults to staging URLs if unset.
