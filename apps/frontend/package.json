{
  "name": "website",
  "version": "0.1.4",
  "private": true,
  "description": "Prophetic Glorious Manifestation — Pastoral School for pastors, ministers and prophets. Owerri, Imo State.",
  "scripts": {
    "dev": "svelte-kit sync && vite dev --port 5180 --host 0.0.0.0",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
    "@tailwindcss/vite": "^4.0.0-alpha.32",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.2",
    "globals": "^17.3.0",
    "svelte-eslint-parser": "^0.43.0",
    "typescript-eslint": "^8.56.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.2",
    "svelte": "^5.8.3",
    "svelte-check": "^3.6.4",
    "tailwindcss": "^4.0.0-alpha.32",
    "typescript": "^5.5.4",
    "vite": "^5.3.1"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/outfit": "^5.0.0"
  }
}
