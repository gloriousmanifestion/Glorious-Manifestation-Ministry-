# Example systemd unit for frontend (production).
# IMPORTANT: Create a service file named: pgm-frontend-production.service
# (e.g., solo-template-frontend-production.service) in infra/systemd/ before deploying.
# The CI/CD workflow expects this file to exist.
# Copy to /etc/systemd/system/pgm-frontend-production.service on the VM.
# Serves from /opt/pgm/frontend/production (e.g. SvelteKit adapter-node build).

[Unit]
Description=Prophetic Glorious Manifestation Frontend (production)
After=network-online.target
Wants=network-online.target
# Do not start until deploy has placed serve.mjs (avoids CHDIR loop and empty-dir start)
ConditionPathExists=/opt/pgm/frontend/production/serve.mjs

[Service]
Type=simple
WorkingDirectory=/opt/pgm/frontend/production
ExecStart=/usr/bin/node serve.mjs
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/default/pgm-frontend-production
Environment=PORT=6400

[Install]
WantedBy=multi-user.target
