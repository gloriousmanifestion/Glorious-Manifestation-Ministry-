# Example systemd unit for backend (staging).
# IMPORTANT: Create a service file named: pgm-backend-staging.service
# (e.g., solo-template-backend-staging.service) in infra/systemd/ before deploying.
# The CI/CD workflow expects this file to exist.
# Copy to /etc/systemd/system/pgm-backend-staging.service on the VM.
# Path: /opt/pgm/backend/backend
# Set APP_NAME via VM_APP_NAME secret or use pgm.

[Unit]
Description=Prophetic Glorious Manifestation Backend API (staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/pgm/backend/backend
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/pgm/backend
EnvironmentFile=-/etc/default/pgm-backend-staging

[Install]
WantedBy=multi-user.target
