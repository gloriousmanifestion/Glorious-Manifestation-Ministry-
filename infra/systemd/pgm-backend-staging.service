# PGM backend API (staging). Port 5800.
# Copy to /etc/systemd/system/pgm-backend-staging.service on the VM.
# Path: /opt/pgm/backend/backend
# Set PORT=5800 in /etc/default/pgm-backend-staging (or here).

[Unit]
Description=PGM Backend API (staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/pgm/backend/backend
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/pgm/backend
EnvironmentFile=-/etc/default/pgm-backend-staging
Environment=PORT=5800

[Install]
WantedBy=multi-user.target
