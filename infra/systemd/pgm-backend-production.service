# Example systemd unit for backend (production).
# IMPORTANT: Create a service file named: pgm-backend-production.service
# (e.g., solo-template-backend-production.service) in infra/systemd/ before deploying.
# The CI/CD workflow expects this file to exist.
# Copy to /etc/systemd/system/pgm-backend-production.service on the VM.
# Path: /opt/pgm/backend/backend

[Unit]
Description=Prophetic Glorious Manifestation Backend API (production)
After=network-online.target
Wants=network-online.target
# Do not start until deploy has placed the backend binary (avoids CHDIR loop and empty-dir start)
ConditionPathExists=/opt/pgm/backend/backend

[Service]
Type=simple
ExecStart=/opt/pgm/backend/backend
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/pgm/backend
EnvironmentFile=-/etc/default/pgm-backend-production

[Install]
WantedBy=multi-user.target
