# Example systemd unit for frontend (staging).
# IMPORTANT: Create a service file named: pgm-frontend-staging.service
# (e.g., solo-template-frontend-staging.service) in infra/systemd/ before deploying.
# The CI/CD workflow expects this file to exist.
# Copy to /etc/systemd/system/pgm-frontend-staging.service on the VM.
# Serves from /opt/pgm/frontend/staging (e.g. SvelteKit adapter-node build).
# Adjust ExecStart if using a static server (nginx/caddy) instead of Node.

[Unit]
Description=Prophetic Glorious Manifestation Frontend (staging)
After=network-online.target
Wants=network-online.target
# Do not start (and avoid restart loop) until deploy has created the directory
ConditionPathExists=/opt/pgm/frontend/staging

[Service]
Type=simple
WorkingDirectory=/opt/pgm/frontend/staging
ExecStart=/usr/bin/node serve.mjs
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/default/pgm-frontend-staging
Environment=PORT=6200

[Install]
WantedBy=multi-user.target
