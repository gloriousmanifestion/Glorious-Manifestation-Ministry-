# PGM frontend (staging). Port 5801.
# Copy to /etc/systemd/system/pgm-frontend-staging.service on the VM.
# Serves from /opt/pgm/frontend/staging (SvelteKit adapter-node build).

[Unit]
Description=PGM Frontend (staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pgm/frontend/staging
ExecStart=/usr/bin/node serve.mjs
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/default/pgm-frontend-staging
Environment=PORT=5801

[Install]
WantedBy=multi-user.target
